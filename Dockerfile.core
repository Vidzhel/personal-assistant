FROM node:22-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# All workspace manifests are required for the checked-in npm lockfile.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY packages/core/package.json packages/core/tsconfig.json packages/core/
COPY packages/web/package.json packages/web/
RUN npm ci

COPY packages/shared/src/ packages/shared/src/
COPY packages/core/src/ packages/core/src/
COPY packages/core/scripts/ packages/core/scripts/
COPY migrations/ migrations/
RUN npm run build:core

FROM node:22-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    bash openssh-client curl python3 python3-venv make g++ ripgrep jq file unzip \
    poppler-utils pandoc ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/node_modules node_modules
COPY --from=builder /app/package.json package.json
COPY --from=builder /app/packages/shared/dist packages/shared/dist
COPY --from=builder /app/packages/shared/package.json packages/shared/
# Core's build includes its SQL migrations and compiled background services.
COPY --from=builder /app/packages/core/dist packages/core/dist
COPY --from=builder /app/packages/core/package.json packages/core/
COPY deployment/ deployment/

# Fail the build if the context allowlist drops a runtime/setup entrypoint.
RUN test -s deployment/entrypoint.mjs \
    && test -s deployment/runtime-init.mjs \
    && mkdir -p /app/library \
    && node deployment/install-ticktick.mjs --check

RUN mkdir -p /app/data /app/projects /app/library /app/config /home/node/.claude \
    && chown node:node /app /app/data /app/projects /app/library /app/config /home/node/.claude
USER node
ENV NODE_ENV=production NEO4J_ENABLED=false CLAUDE_CONFIG_DIR=/home/node/.claude
EXPOSE 4001
ENTRYPOINT ["node", "deployment/entrypoint.mjs"]
CMD ["node", "packages/core/dist/index.js"]
