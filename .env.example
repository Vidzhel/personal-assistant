# ── Claude API ──────────────────────────────────────────────
# If using MAX plan: leave ANTHROPIC_API_KEY empty/unset.
# The SDK uses Claude CLI auth (run `claude auth login` first for native development).
# For Docker, scripts/raven.sh start handles login in its separate auth volume.
# If using API credits: set your key here instead.
ANTHROPIC_API_KEY=
# Optional override; omit to use the default in packages/core/src/config.ts.
# CLAUDE_MODEL=your-available-model

# ── TickTick official MCP ───────────────────────────────────
# Create a dedicated token in TickTick web: Settings → Account → API Token.
# Prefer ./scripts/raven.sh setup-ticktick so the token is read without echo.
TICKTICK_MCP_TOKEN=

# ── Gmail IMAP (App Password) ──────────────────────────────
# Leave both empty to keep the IMAP service disabled.
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=

# ── Gmail MCP (OAuth - used by sub-agents) ─────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Group mode (optional — enables topic threads)
TELEGRAM_GROUP_ID=                    # Telegram group/supergroup ID (negative number)
TELEGRAM_TOPIC_GENERAL=              # General topic thread ID (usually 1)
TELEGRAM_TOPIC_SYSTEM=               # System alerts topic thread ID
TELEGRAM_TOPIC_MAP=                  # JSON: topicName → threadId, e.g. '{"Work":5,"Personal":7}'

# Calendar reads: setup-google-calendar imports existing GWS credentials into Docker.
GOOGLE_CALENDAR_CREDENTIALS_FILE=       # Exported credentials path for local core runs only

# ── Google Workspace (gws CLI) ────────────────────────────
GWS_PRIMARY_CREDENTIALS_FILE=           # Path to primary gws credentials JSON (gws auth export --unmasked)
GWS_SECONDARY_CREDENTIALS_FILE=        # Path to second account credentials JSON (optional)
GWS_GCP_PROJECT_ID=                     # GCP project ID for Gmail Pub/Sub watch
GWS_DRIVE_POLL_INTERVAL_MS=300000       # Drive changes poll interval (default 5 min)

# ── Google Gemini (Voice Transcription) ───────────────────
GOOGLE_API_KEY=

# ── Financial Tracking (Bank → YNAB) ─────────────────────
YNAB_ACCESS_TOKEN=
MONOBANK_TOKEN=
PRIVATBANK_TOKEN=
# FINANCIAL_SYNC_INTERVAL_MS=3600000
# FINANCIAL_CATEGORY_SYNC_INTERVAL_MS=14400000

# ── Raven System ────────────────────────────────────────────
RAVEN_PORT=4001
RAVEN_TIMEZONE=Europe/London
# Legacy RAVEN_DIGEST_TIME is unused; set cron in the schedule definition.
RAVEN_MAX_CONCURRENT_AGENTS=3
# Daily Claude query estimate budget; zero blocks model admission.
# Includes nested query agents; unknown usage retains its reservation.
# Not a subscription bill or strict billing cap; excludes Gemini/external commands.
RAVEN_MAX_BUDGET_USD_PER_DAY=5
DATABASE_PATH=./data/raven.db
SESSION_PATH=./data/sessions
LOG_LEVEL=info

# ── Optional knowledge graph ────────────────────────────────
# false prevents every graph driver/connection, while chat and agent memory work.
# Existing installations default to true if this setting is absent.
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Docker launcher and repository mounts ───────────────────
# scripts/raven.sh reads this .env through Compose, never as shell code.
# Uncomment these to use a separate local test stack with attached repositories.
# Set an existing absolute parent path; it is mounted at /workspace in core.
# COMPOSE_PROJECT_NAME=raven-test
# COMPOSE_FILE=docker-compose.yml:docker-compose.workspace.yml
# RAVEN_WORKSPACE_ROOT=/absolute/path/to/repositories
# To start graph knowledge too, set NEO4J_ENABLED=true and a persistent password
# above, and uncomment this profile. Keep that password for the graph volume.
# COMPOSE_PROFILES=knowledge
# Browser endpoints are build-time settings; defaults work on this machine.
# NEXT_PUBLIC_CORE_API_URL=http://localhost:4001/api
# NEXT_PUBLIC_CORE_WS_URL=ws://localhost:4001/ws

# Private phone access: scripts/raven.sh setup-private-access prepares these.
# Use the private HTTPS origin from Tailscale Serve, without a path.
# RAVEN_BASE_URL=https://your-raven-machine.your-tailnet.ts.net
# Extra exact browser origins for deliberate development access (comma-separated).
# RAVEN_BROWSER_ORIGINS=http://127.0.0.1:4000
# Gateway username/password hash are written by setup; do not put plaintext here.
