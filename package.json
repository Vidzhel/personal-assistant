{
  "name": "raven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/web",
    "packages/mcp-ticktick"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "dev": "concurrently -n core,web -c blue,green \"npm run dev:core\" \"npm run dev:web\"",
    "dev:core": "npm run dev -w packages/core",
    "dev:web": "npm run dev -w packages/web",
    "start:core": "npm run start -w packages/core",
    "lint": "eslint --max-warnings 0 packages/*/src && npm run typecheck -w packages/shared && npm run typecheck -w packages/core",
    "lint:fix": "eslint --fix packages/*/src",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}'",
    "check:strip-types": "bash scripts/check-strip-types.sh",
    "check": "npm run format:check && npm run lint && npm run check:strip-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mcp": "vitest run --project mcp-ticktick",
    "test:mcp:watch": "vitest --project mcp-ticktick",
    "test:knowledge": "RAVEN_TEST_KNOWLEDGE=1 vitest run --project knowledge-neo4j",
    "validate:library": "node --experimental-strip-types scripts/validate-library.ts",
    "validate:projects": "node --experimental-strip-types scripts/validate-projects.ts",
    "test:ticktick": "node --experimental-strip-types scripts/test-ticktick-manual.ts",
    "update:gws": "bash scripts/update-gws-skills.sh",
    "build:core": "npm run build -w packages/shared && npm run build -w packages/core && npm run build -w packages/mcp-ticktick",
    "build:web": "npm run build -w packages/web -- --webpack",
    "test:compiled": "node scripts/smoke-compiled-core.mjs",
    "test:containers": "node scripts/smoke-containers.mjs",
    "test:deployment": "node --experimental-strip-types --test deployment/runtime-init.test.mjs",
    "test:docker-context": "node scripts/check-docker-context.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/js-yaml": "^4.0.9",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "grammy": "^1.45.1",
    "imapflow": "^1.2.15",
    "ynab": "^4.5.0"
  }
}
