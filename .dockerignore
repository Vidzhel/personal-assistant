# Deliberate build inputs only. In particular, never send the checkout's
# projects/, library/, data/, config/, credentials, or development-agent state.
**
!package.json
!package-lock.json
!tsconfig.base.json
!packages/
packages/*
!packages/shared/
packages/shared/*
!packages/shared/package.json
!packages/shared/tsconfig.json
!packages/shared/src/
!packages/shared/src/**
!packages/core/
packages/core/*
!packages/core/package.json
!packages/core/tsconfig.json
!packages/core/scripts/
packages/core/scripts/*
!packages/core/scripts/copy-build-assets.mjs
!packages/core/src/
!packages/core/src/**
!packages/web/
packages/web/*
!packages/web/package.json
!packages/web/tsconfig.json
!packages/web/next.config.ts
!packages/web/postcss.config.mjs
!packages/web/src/
!packages/web/src/**
!migrations/
migrations/*
!migrations/*.sql
!scripts/
scripts/*
!scripts/smoke-compiled-core.mjs
!scripts/smoke-compiled-core-worker.mjs
!deployment/
deployment/*
!deployment/runtime-init.mjs
!deployment/entrypoint.mjs
!deployment/seeds/
!deployment/seeds/**
# Tests and generated/cache files are not production source inputs.
**/__tests__/**
**/*.test.*
**/*.spec.*
**/node_modules/**
**/.next/**
**/dist/**
**/.env*
**/*.log
**/*.db*
**/*.sqlite*
**/*.tsbuildinfo
**/next-env.d.ts
**/vitest*.config.*
